<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Button?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.pfinancas.controle.NovaTransacaoControle"
      styleClass="paginaFormulario">

    <Label text="Nova transação"
           styleClass="titulo"/>

    <Label text="Registre uma receita ou despesa"
           styleClass="subtitulo"/>

    <GridPane styleClass="formulario">

        <Label text="Descrição:"
               GridPane.columnIndex="0"
               GridPane.rowIndex="0"/>

        <TextField
                fx:id="campoDescricao"
                styleClass="campo"
                GridPane.columnIndex="1"
                GridPane.rowIndex="0"/>

        <Label text="Valor:"
               GridPane.columnIndex="0"
               GridPane.rowIndex="1"/>

        <TextField
                fx:id="campoValor"
                styleClass="campo"
                GridPane.columnIndex="1"
                GridPane.rowIndex="1"/>

        <Label text="Tipo:"
               GridPane.columnIndex="0"
               GridPane.rowIndex="2"/>

        <ComboBox
                fx:id="campoTipo"
                styleClass="campo"
                GridPane.columnIndex="1"
                GridPane.rowIndex="2"/>

        <Label text="Data:"
               GridPane.columnIndex="0"
               GridPane.rowIndex="3"/>

        <DatePicker
                fx:id="campoData"
                styleClass="campo"
                GridPane.columnIndex="1"
                GridPane.rowIndex="3"/>

        <Button
                fx:id="botaoVoltar"
                text="Voltar"
                styleClass="botaoRemover"
                onAction="#voltar"
                GridPane.columnIndex="0"
                GridPane.rowIndex="4"/>

        <Button
                text="Salvar"
                styleClass="botaoAdicionar"
                onAction="#salvar"
                GridPane.columnIndex="1"
                GridPane.rowIndex="4"/>

    </GridPane>

</VBox>