<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>

<BorderPane fx:controller = "com.pfinancas.controle.TelaPrincipalControle" xmlns:fx="http://javafx.com/fxml">
    <top>

        <VBox styleClass="cabecalho">

            <Label text="FinTrack" styleClass="titulo"/>
            <Label text="Controle suas finanças" styleClass="subtitulo"/>

        </VBox>

    </top>

    <center>

        <VBox styleClass="conteudo">

           <VBox styleClass="cardSaldo">

                <Label text="SALDO DISPONÍVEL" styleClass="tituloSaldo"/>

                <Label fx:id="labelSaldo" text="Saldo atual: R$ 0,00" styleClass="saldo"/>

            </VBox>

            <Label text="Transações" styleClass ="tituloSecao"/>

            <TableView fx:id="tabelaTransacoes">

            <columns>

                    <TableColumn fx:id="colunaDescricao" text="Descricao"/>

                    <TableColumn fx:id="colunaValor" text="Valor"/>

                    <TableColumn fx:id="colunaTipo" text="Tipo"/>

                    <TableColumn fx:id="colunaData" text="Data"/>

                </columns>

            </TableView>

        </VBox>

    </center>
    
    <bottom>

        <HBox styleClass = "acoes">

            <Button fx:id="botaoNovaTransacao" text="Nova transação" onAction="#novaTransacao" styleClass="botaoAdicionar"/>
            <Button text="Remover transação" onAction="#removerTransacao" styleClass="botaoRemover"/>
            <Button fx:id="botaoRelatorio" text="Relatório" onAction="#abrirRelatorio" styleClass="botaoRemover"/>

        </HBox>

    </bottom>

</BorderPane>